# PostgreSQL admin connection used by scripts/init-db.ts.
# If you use scripts/postgres-dev.sh on macOS, replace <local-user> with your macOS username.
POSTGRES_ADMIN_URL=postgres://<local-user>@localhost:5432/postgres

# Platform identity database used by apps/api and packages/identity.
IDENTITY_DATABASE_URL=postgres://<local-user>@localhost:5432/platform_identity_db

# Module databases.
NANO_BRAIN_DATABASE_URL=postgres://<local-user>@localhost:5432/nano_brain_db
TRADITIONAL_RAG_DATABASE_URL=postgres://<local-user>@localhost:5432/traditional_rag_db
GRAPH_RAG_DATABASE_URL=postgres://<local-user>@localhost:5432/graph_rag_db

# Agent Gateway database.
# Use the same PostgreSQL instance as other local databases, but keep a separate database.
AGENT_DATABASE_URL=postgres://<local-user>@localhost:5432/agent_gateway_db
AGENT_CHECKPOINT_SCHEMA=langgraph

# apps/api
API_PORT=3001

# Internal RAG module HTTP services. Use a non-default secret locally/deployment.
RAG_INTERNAL_TOKEN=change-me-internal-token
NANO_BRAIN_HTTP_PORT=8100
NANO_BRAIN_HTTP_URL=http://127.0.0.1:8100
TRADITIONAL_RAG_HTTP_PORT=8101
TRADITIONAL_RAG_HTTP_URL=http://127.0.0.1:8101
GRAPH_RAG_HTTP_PORT=8102
GRAPH_RAG_HTTP_URL=http://127.0.0.1:8102

# scripts/create-admin.ts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Shared embedding configuration for all RAG modules.
# OpenRouter uses an OpenAI-compatible API.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=<your-openrouter-api-key>
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# P7-B chunking：默认字符切分（评测最优基线）。token chunking 为 opt-in（P7-A 评测显示当前语料下
# token 化不优于字符基线，故默认关）。置 1 才启用「按 embedding 模型分词器计 token 尺寸」。
CHUNK_TOKEN_MODE=0
# token 模式用的本地 vendored tokenizer.json（离线/国内稳，零运行时网络）；用 scripts/fetch-tokenizers.sh 下载。
# 缺失则 token 模式退回字符兜底（不做运行时联网拉取）。CHUNK_TOKEN_MODE=0 时本项不生效。
EMBEDDING_TOKENIZER_PATH=assets/tokenizers/qwen3-embedding-8b/tokenizer.json

# Agent model configuration for LangChain agents.
# Keep AGENT_API_KEY local only; do not commit real secrets.
AGENT_PROVIDER=openai-compatible
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_API_KEY=<your-openrouter-api-key>
AGENT_MODEL=deepseek/deepseek-v4-flash
AGENT_TEMPERATURE=0
AGENT_STREAM_USAGE=false

# 全域问答检索后相关性精排（reranker）。可选；未配置任何 Rerank 变量时跳过精排，保留全部召回。
# RERANK_PROVIDER 决定请求/响应格式与默认端点/模型：
#   dashscope（默认，阿里云百炼，中国区）  → DASHSCOPE_API_KEY
#   cohere（全球）                        → RERANK_API_KEY，默认 api.cohere.com/v2/rerank + rerank-v3.5
#   jina（全球）                          → RERANK_API_KEY，默认 api.jina.ai/v1/rerank + jina-reranker-v2-base-multilingual
#   voyage（全球）                        → RERANK_API_KEY，默认 api.voyageai.com/v1/rerank + rerank-2.5
# RERANK_BASE_URL / RERANK_MODEL 可覆盖对应 provider 的默认值。
RERANK_PROVIDER=dashscope
# 非 dashscope provider 使用此 Key；dashscope 也可用它覆盖 DASHSCOPE_API_KEY。
RERANK_API_KEY=
DASHSCOPE_API_KEY=<your-dashscope-api-key>
# 可选覆盖：留空即使用所选 provider 的默认端点和模型（见上方注释）。
# RERANK_BASE_URL=
# RERANK_MODEL=
RERANK_MIN_SCORE=0.4
RERANK_TOP_N=5
